    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="ncrontab" Version="3.4.0" />
    <PackageReference Include="NCrontab.Scheduler" Version="2.1.23" />
    <PackageReference Include="ResourceLoader" Version="3.4.5-pre" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="eXoCooLd.Waveshare.EPaperDisplay" Version="1.0.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <PackageReference Include="Svg.Skia" Version="4.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\Fonts\" />
  </ItemGroup>
</Project>
